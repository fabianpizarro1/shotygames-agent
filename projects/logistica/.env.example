# Google Sheets — las mismas credenciales que usa KEPLER en su .env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Sheet de pedidos de dropshipping (Truquito + Avanora, columna TIENDA los separa)
SHEETS_ID_DROPSHIPPING=

# Cuenta DROPSHIPPER de DROPI (la segunda cuenta). Tiene 2FA desde el 2026-08-30.
DROPI2_EMAIL=
DROPI2_PASSWORD=
DROPI2_TOTP_SECRET=

# Login de la app — la app expone direcciones y teléfonos de clientes reales
APP_PASSWORD=

# Sheet de pedidos de ShotyGames (el REAL, donde se editan — el mismo
# GOOGLE_SHEETS_PEDIDOS_ID que usa adm.shotygames.com, no el espejo IMPORTRANGE)
SHEETS_ID_SHOTYGAMES=

# Cuenta de DROPI de ShotyGames (la PRIMERA, donde Fabián es el proveedor).
# No confundir con DROPI2_*, que es la de dropshipping. Un token no sirve
# para consultar órdenes de la otra cuenta.
DROPI_EMAIL=
DROPI_PASSWORD=
DROPI_TOTP_SECRET=

# Evolution API (WhatsApp) — LAS MISMAS que usa adm.shotygames.com, para que el
# agradecimiento salga del mismo número. Instancia "shotygames".
EVOLUTION_API_URL=
EVOLUTION_INSTANCE_ID=
EVOLUTION_API_KEY=

# Solo para pruebas locales: escribe el mensaje en consola en vez de mandarlo.
# NUNCA ponerla en Vercel — en producción el envío tiene que ser real.
# WHATSAPP_SIMULAR=1
