# Google Sheets — las mismas credenciales que usa KEPLER en su .env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Token con scope de Calendar (el de arriba solo tiene Sheets/Drive). El mismo
# GOOGLE_CALENDAR_TOKEN del .env de KEPLER. Lo usa el chat para agendar.
GOOGLE_CALENDAR_TOKEN=

# Sheet del bot PERSONAL de Telegram (pestañas TAREAS y RUTINA).
# Mismo Sheet que usa sheets-personal.js en la raíz de KEPLER — es
# a propósito, esta app NO tiene datos propios, lee/escribe lo mismo
# que ya usa el bot para que nunca queden desincronizados.
SHEETS_ID_PERSONAL=

# Login de la app — es tu rutina, tus tareas y tu progreso personal.
APP_PASSWORD=
ANTHROPIC_API_KEY=

# Voz del chat (transcribir audios y leer respuestas). La misma clave del .env de KEPLER.
OPENAI_API_KEY=

# Sheets de negocio, SOLO LECTURA (los mismos ids del .env de KEPLER):
# PEDIDOS de ShotyGames, Contabilidad (DEUDAS, SALDOS_REALES), Ventas digitales, Dropshipping.
SHEETS_ID=
SHEETS_ID_FINANZAS=
SHEETS_ID_VENTAS_DIGITALES=
SHEETS_ID_DROPSHIPPING=
