# Plataforma de invitaciones — variables de entorno
# SESSION_SECRET: mínimo 16 caracteres, aleatorio (firma las cookies de sesión)
SESSION_SECRET=
# local (archivo .data/db.json, para desarrollar) | supabase (todavía no implementado)
DB_DRIVER=local
ANTHROPIC_API_KEY=
# opcional: modelo de la IA de diseño (por defecto claude-sonnet-5-5)
IA_MODELO=
